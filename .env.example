# Copy the ones you need into your host's environment-variable settings.
# Everything here also works as a key in config.json, but on a public host
# environment variables are the right place: nothing secret lands in the repo.

# --- who can get in -------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-long-one          # only used the very first time the database is created
SECRET_KEY=                               # long random string; keeps people signed in across restarts
PUBLIC_READ=false                         # false = a user ID is needed even to read the portal
SESSION_DAYS=14                           # how long a sign-in lasts
HTTPS_ONLY=                               # 1 on a public https site, 0 on a plain-http office PC (blank = auto)

# --- where the data lives -------------------------------------------------
# Blank  -> portal.db next to app.py (right for an office PC or a VM with a real disk).
# Set it -> PostgreSQL (right for a free cloud host, whose disk is wiped on restart).
DATABASE_URL=
DB_PATH=                                  # optional: another path for the SQLite file

# --- the AI assistant -----------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=                    # low / minimal, if the model supports it
AI_MAX_TOKENS=4000                        # size of the answer
AI_CONTEXT_CHAR_LIMIT=40000               # how much project data one question may carry
AI_DAILY_LIMIT=400                        # the portal's own cap, kept under the free quota
